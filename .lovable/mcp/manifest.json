  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jrjaegapuujushsiofoi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "parium-ab",
      "version": "0.1.0",
      "title": "parium-ab"
