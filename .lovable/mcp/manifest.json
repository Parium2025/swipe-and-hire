            "city": {
              "type": "string",
              "description": "Ort eller kommun att filtrera på."
            },
            "limit": {
              "type": "integer",
              "description": "Max antal träffar, 1–50. Standard 10."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_job",
        "title": "Hämta jobbannons",
        "description": "Hämtar detaljer om en jobbannons på Parium via dess id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "description": "Annonsens id (uuid)."
            }
          },
          "required": [
            "job_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_job_postings",
        "title": "Mina jobbannonser",
        "description": "Listar den inloggade arbetsgivarens egna jobbannonser med antal ansökningar och visningar.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "only_active": {
              "type": "boolean",
              "description": "Visa endast aktiva annonser. Standard false."
            },
            "limit": {
              "type": "integer",
              "description": "Max antal annonser, 1–100. Standard 20."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_job_applications",
        "title": "Ansökningar till en annons",
        "description": "Listar ansökningar till en av arbetsgivarens egna jobbannonser.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "description": "Annonsens id (uuid)."
            },
            "status": {
              "type": "string",
              "description": "Filtrera på status, till exempel pending eller interview."
            },
            "limit": {
              "type": "integer",
              "description": "Max antal ansökningar, 1–100. Standard 25."
            }
          },
          "required": [
            "job_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
